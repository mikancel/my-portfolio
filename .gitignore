# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local database
/db/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
# next-env.d.ts はコミットする。
# これが無いと /// <reference types="next" /> が読まれず、
# fetch の next オプション等の型拡張が効かずCIの型チェックだけが落ちる。

# Claude Code のローカル設定（アプリの動作には無関係）
.claude/
